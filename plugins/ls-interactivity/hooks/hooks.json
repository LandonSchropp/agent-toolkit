{
  "description": "Blocks git commit until the pending changes have been reviewed, and wakes the agent with each decision made in an open Hunk review.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/require-review.rb"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/hunk-verdict.sh",
            "asyncRewake": true,
            "timeout": 604800
          }
        ]
      }
    ]
  }
}

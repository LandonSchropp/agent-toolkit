{
  "description": "Formats edited shell scripts with shfmt.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/shfmt.sh"
          }
        ]
      }
    ]
  }
}

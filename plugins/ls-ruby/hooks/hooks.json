{
  "description": "Autocorrects edited Ruby files with RuboCop.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/rubocop.sh"
          }
        ]
      }
    ]
  }
}
